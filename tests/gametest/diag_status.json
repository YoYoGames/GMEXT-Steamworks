  },
  {
   "id": "count",
   "src": "show_debug_message(\"gametest: control callbacks \" + string(gametest_event_count(\"ctl\")));\nvar i = steam_networking_sockets_get_connection_info(global.d_conn);\nshow_debug_message(\"gametest: conn info \" + (is_struct(i) ? json_stringify(i) : string(i)));\nreturn gametest_event_count(\"ctl\");"
  },
  {
   "id": "pair",
   "src": "global.d_pair = steam_networking_sockets_create_socket_pair(true);\nshow_debug_message(\"gametest: pair \" + string(global.d_pair));\nreturn 1;"
  },
  {
   "id": "count2",
   "src": "show_debug_message(\"gametest: callbacks after loopback pair \" + string(gametest_event_count(\"ctl\")));\nreturn gametest_event_count(\"ctl\");"
  },
  {
   "id": "pump",
   "src": "steam_networking_sockets_run_callbacks(); return 1;"
  }
